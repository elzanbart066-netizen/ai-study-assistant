# Server port (the Vite dev server proxies /api to it)
PORT=3001

# Session signing secret; at least 32 characters in production
SESSION_SECRET=

# Claude API key (server-side only, never sent to the browser).
# Without it the site runs in offline mode: built-in solver, code templates and Wikipedia search.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Web search: on (default) or off
WEB_SEARCH=on

# Data layer: memory (prototype, demo data) or mysql
DB_DRIVER=memory
MYSQL_URL=mysql://user:password@localhost:3306/ai_study_assistant

# Folder for generated files and images
STORAGE_DIR=storage

# Demo account (demo@study.kz / demo12345) in memory mode: on or off
SEED_DEMO=on
